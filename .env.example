# AbhiNova AI — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Supabase (NEXT_PUBLIC_ = safe for the browser; anon key is protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Secret/service-role key: SERVER-ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# --- LLM providers (SERVER-ONLY — never NEXT_PUBLIC_) ---
GROQ_API_KEY=gsk_your-groq-key
GEMINI_API_KEY=your-gemini-key

# --- Local Mode (OPTIONAL, your own computer only) ---------------------------------
# Set OLLAMA_URL to run every AI call (chat + embeddings) on Ollama on this machine:
# no cloud model, no API key, no daily beta AI limits. Leave unset on Vercel.
#   1. Install Ollama (ollama.com), then:  ollama pull llama3.2  and  ollama pull nomic-embed-text
#   2. Uncomment the line below and restart `npm run dev`. (OLLAMA_URL=off, or no line, = cloud models.)
# Documents processed in Local Mode are only searchable in Local Mode (and vice versa).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- BYOK encryption ---
# 32 random bytes, base64-encoded. Used to AES-GCM-encrypt user API keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=base64-encoded-32-byte-key

# --- Connectors (OPTIONAL, SERVER-ONLY) ---
# Each pair comes from an OAuth app you create with that provider. Leave blank
# and the connector shows "Not set up on this server" — everything else works.
# Callback URL to register with each provider:
#   https://<your-domain>/api/connectors/<provider>/callback
#   (local: http://localhost:3000/api/connectors/<provider>/callback)
# Jira  → developer.atlassian.com → OAuth 2.0 (3LO), scopes: read:jira-work read:jira-user offline_access
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps (no scopes requested = public read-only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Notion → notion.so/my-integrations → Public integration, capability "Read content" only
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Google Drive → console.cloud.google.com → OAuth client (Web), scope drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Open beta -----------------------------------------------------------------
# ON by default: no login/signup pages — every visitor gets an anonymous guest
# session automatically, with per-user / per-IP / site-wide daily AI limits
# (lib/beta/config.ts). Needs SUPABASE_SERVICE_ROLE_KEY + migration 003.
# Set to "false" (and redeploy) to bring login/signup back.
NEXT_PUBLIC_OPEN_BETA=true

# --- Owner usage dashboard (/admin) ----------------------------------------------
# 16+ random characters (node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))").
# Unset = dashboard disabled. Never share it; it opens the owner-only stats page.
ADMIN_DASHBOARD_TOKEN=
