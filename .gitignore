# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
# e2e run reports (may contain AI answers)
/tests/out/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — NEVER commit secrets (any .env variant except .env.example)
.env
.env.*
!.env.example

# personal learning notes — NEVER pushed, permanently ignored
/private-learning

# scratch folders
/docs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code / preview config
/.claude/
